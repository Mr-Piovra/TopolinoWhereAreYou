# ================================================================
# CONFIGURAZIONE MONITOR PANINI "TOPOLINO 3694"
# ================================================================

# Inserisci qui il token del bot Telegram (es. da @BotFather o il bot server)
TELEGRAM_BOT_TOKEN=

# Inserisci qui il tuo ID Telegram (es. 1370655095)
TELEGRAM_CHAT_ID=

# URL del prodotto da monitorare
TARGET_URL=https://www.panini.it/shp_ita_it/topolino-3694-con-seconda-parte-modellino-f1-1wtopo3694v-it08.html

# Frequenza di controllo base in secondi (Consigliata: 35s)
CHECK_INTERVAL_SECONDS=35

# Jitter casuale (+/- 8s) per evitare richieste a orari fissi e prevenire blocchi
JITTER_SECONDS=8

# Numero di notifiche inviate a raffica alla prima comparsa del prodotto
BURST_COUNT=3

# Secondi tra le notifiche della raffica
BURST_DELAY_SECONDS=2.0

# Minuti tra un promemoria e il successivo finché non scrivi /stop su Telegram
REPEAT_INTERVAL_MINUTES=3

# Frequenza del messaggio di stato "Heartbeat" (60 = ogni ora)
HEARTBEAT_INTERVAL_MINUTES=60

# Se condividi il bot con watchdog o un altro servizio, imposta a false per disabilitare il polling getUpdates
ENABLE_POLLING=true

# Porta della micro API HTTP interna per integrazione con watchdog / comandi
API_HOST=0.0.0.0
API_PORT=8085

# File di stato interno persistente
STATE_FILE=data/monitor_state.json

# Livello di log
LOG_LEVEL=INFO
